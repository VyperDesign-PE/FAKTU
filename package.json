{
  "name": "faktu",
  "private": true,
  "version": "0.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace @app/api run dev",
    "dev:mobile": "npm --workspace @app/mobile run start",
    "migrate": "npm --workspace @app/api run migrate",
    "typecheck": "npm --workspace @app/api run typecheck && npm --workspace @app/mobile run typecheck",
    "sync:sunat-ruc": "npm --workspace @app/api run sync:sunat-ruc",
    "test:sunat-ruc-parser": "npm --workspace @app/api run test:sunat-ruc-parser",
    "e2e:up": "docker compose -f infra/docker-compose.e2e.yml up --build --abort-on-container-exit --exit-code-from e2e",
    "e2e:down": "docker compose -f infra/docker-compose.e2e.yml down -v",
    "test:apisperu-adapter": "npm --workspace @app/api run test:apisperu-adapter",
    "test:apisperu-sandbox": "npm --workspace @app/api run test:apisperu-sandbox",
    "test:unit": "npm --workspace @app/api run test:unit",
    "test:integration": "npm --workspace @app/api run test:integration",
    "test": "npm run test:unit && npm run test:apisperu && npm run test:nubefact && npm run test:apisperu-adapter && npm run test:sunat-ruc-parser && npm run test:mobile",
    "test:nubefact": "npm --workspace @app/api run test:nubefact",
    "build:web": "npm --workspace @app/mobile run build:web",
    "dev:web": "npm --workspace @app/mobile run web",
    "ops:activation": "npm --workspace @app/api run ops:activation --",
    "ops:secret": "npm --workspace @app/api run ops:secret --",
    "worker": "npm --workspace @app/api run worker",
    "demo:seed": "npm --workspace @app/api run demo:seed",
    "demo:up": "docker compose -f infra/docker-compose.demo.yml up --build -d",
    "demo:down": "docker compose -f infra/docker-compose.demo.yml down -v",
    "test:apisperu": "npm --workspace @app/api run test:apisperu",
    "test:mobile": "npm --workspace @app/mobile run test:domain"
  }
}
