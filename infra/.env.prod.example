# Copia a infra/.env.prod y completa. NO lo subas a Git.
DOMAIN=app.tudominio.pe
# Genera cada secreto con:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
# Clave maestra de la bóveda de credenciales (cifra los tokens de proveedor y los secretos 2FA).
# Guarda una copia FUERA del servidor: sin ella los secretos guardados no se pueden recuperar.
SECRETS_MASTER_KEY=
PUBLIC_RECEIPT_LINK_SECRET=
# Piloto real con SUNAT: BILLING_PROVIDER=apisperu (ver docs/PILOTO.md); demo: mock
BILLING_PROVIDER=mock
ALLOW_MOCK_BILLING=true
# true solo para una demo pública (carga "Bodega Don Pepe" al primer arranque)
DEMO_AUTOSEED=false
# true para una demo pública: muestra el botón "Ver la demo" (la cuenta demo no puede activar 2FA ni cerrar sesiones ajenas)
DEMO_PUBLIC_LOGIN=false
# Opcional: webhook de Slack o Discord para alertas operativas
ALERT_WEBHOOK_URL=
