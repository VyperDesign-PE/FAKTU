{
  "name": "@app/mobile",
  "version": "0.19.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist-web",
    "test:domain": "tsx tests/domain.ts && tsx tests/navigation.ts && tsx tests/palette.ts && tsx --require ./tests/stubs/register.cjs tests/queue.ts",
    "sync:palette": "tsx scripts/sync-palette.ts",
    "icons": "tsx scripts/generate-icons.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "expo": "^53.0.0",
    "expo-secure-store": "~14.2.3",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.2",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  }
}
