NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/facturacion
JWT_SECRET=replace-with-a-long-random-secret-before-production
DB_POOL_SIZE=10
DB_AUTO_MIGRATE=true

# Series por defecto del tenant. Más adelante se administrarán por pantalla.
DEFAULT_BOLETA_SERIES=B001
DEFAULT_FACTURA_SERIES=F001

# Proveedor de facturación por defecto para tenants sin configuración específica.
# Valores previstos: mock | apisperu | nubefact | efact | senda | facturadorpe | cpeapi | external
BILLING_PROVIDER=mock
BILLING_API_BASE_URL=
BILLING_API_TOKEN=
BILLING_ISSUE_PATH=/documents
BILLING_HEALTH_PATH=/health

# Ejemplo de configuración específica por proveedor.
NUBEFACT_API_BASE_URL=
NUBEFACT_API_TOKEN=
NUBEFACT_ISSUE_PATH=
NUBEFACT_HEALTH_PATH=

# Consulta automatizada de clientes DNI/RUC.
# Mantener el token SOLO en backend. Nunca usar EXPO_PUBLIC_ para este secreto.
# Valores: mock | apiperudev | external
DOCUMENT_LOOKUP_PROVIDER=mock
DOCUMENT_LOOKUP_API_BASE_URL=https://api.apiperu.dev
DOCUMENT_LOOKUP_API_TOKEN=
DOCUMENT_LOOKUP_TIMEOUT_MS=8000

# Costo unitario estimado del contrato con el proveedor de DNI.
# Ejemplo comercial: S/ 30 / 1000 consultas => 0.03.
# Se deja en 0 hasta definir el contrato real.
DOCUMENT_LOOKUP_DNI_COST_PEN=0

# Proveedores candidatos. Los tokens permanecen solo en backend/Secret Manager.
APISPERU_API_BASE_URL=https://facturacion.apisperu.com/api/v1/
APISPERU_API_TOKEN=
APISPERU_TIMEOUT_MS=15000
APISPERU_HEALTH_PATH=

EFACT_API_BASE_URL=
EFACT_API_TOKEN=
EFACT_HEALTH_PATH=

SENDA_API_BASE_URL=
SENDA_API_TOKEN=
SENDA_HEALTH_PATH=

# Enlaces públicos firmados para compartir comprobantes.
# En producción PUBLIC_APP_BASE_URL debe ser HTTPS y accesible desde Internet.
PUBLIC_APP_BASE_URL=http://localhost:4000
PUBLIC_RECEIPT_LINK_SECRET=replace-with-a-long-random-secret-for-public-links
# 30 días. Puede renovarse desde el historial.
PUBLIC_RECEIPT_LINK_TTL_SECONDS=2592000

# Entrega automática al cliente.
# disabled = no finge envíos; mock = solo pruebas internas.
# Producción requerirá adaptadores de WhatsApp Business / SMS / Email.
DELIVERY_PROVIDER=disabled

# Padrón Reducido RUC oficial de SUNAT. Se descarga e indexa en PostgreSQL.
# Fuente oficial: https://www.sunat.gob.pe/descargaPRR/mrc137_padron_reducido.html
SUNAT_RUC_PADRON_URL=https://www2.sunat.gob.pe/padron_reducido_ruc.zip
SUNAT_RUC_BATCH_SIZE=5000
# Protección contra archivos truncados/cambios de formato antes de depurar registros viejos.
SUNAT_RUC_MIN_ROWS=5000000
SUNAT_RUC_PRUNE_MISSING=true
# Solo aplica si se usa un proveedor externo como respaldo para RUC no hallado en el padrón.
DOCUMENT_LOOKUP_RUC_COST_PEN=0

# Sandbox real APIsPERU (solo para prueba controlada)
# El token debe corresponder a una empresa configurada en ambiente beta en APIsPERU.
APISPERU_SANDBOX_RUC=
APISPERU_SANDBOX_LEGAL_NAME=
APISPERU_SANDBOX_TRADE_NAME=
APISPERU_SANDBOX_ADDRESS=
APISPERU_SANDBOX_UBIGEO=
APISPERU_SANDBOX_DEPARTMENT=
APISPERU_SANDBOX_PROVINCE=
APISPERU_SANDBOX_DISTRICT=
APISPERU_SANDBOX_SERIES=B001
APISPERU_SANDBOX_CORRELATIVE=1
# Dejar vacio para probar solo conectividad. Colocar YES solo si se desea emitir en beta.
APISPERU_SANDBOX_CONFIRM=
