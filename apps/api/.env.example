NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/facturacion
JWT_SECRET=replace-with-a-long-random-secret-before-production
DB_POOL_SIZE=10
DB_AUTO_MIGRATE=true


# Proveedor de facturación por defecto para tenants sin configuración específica.
# Valores previstos: mock | apisperu | nubefact | efact | senda | facturadorpe | cpeapi | external
BILLING_PROVIDER=mock
BILLING_API_BASE_URL=
BILLING_API_TOKEN=
BILLING_ISSUE_PATH=/documents
BILLING_HEALTH_PATH=/health

# Credenciales de cada negocio (las asigna operaciones; ver `npm run ops:activation -- correo`).
#   BILLING_URL_<tenantId sin guiones, MAYÚSCULAS>=  ruta de su cuenta Nubefact
#   BILLING_TOKEN_<tenantId sin guiones, MAYÚSCULAS>= token de esa cuenta
# BILLING_URL_3F2B8C1A00004000800000000000001=https://api.nubefact.com/api/v1/xxxxxxxx
# BILLING_TOKEN_3F2B8C1A00004000800000000000001=
# Solo sandbox: permite una cuenta demo compartida (NUBEFACT_API_URL/NUBEFACT_API_TOKEN,
# APISPERU_API_TOKEN). Nunca se usa en producción.
BILLING_ALLOW_SHARED_SANDBOX_TOKEN=false
NUBEFACT_API_URL=
NUBEFACT_API_TOKEN=
NUBEFACT_TIMEOUT_MS=20000
# Emisión real ante SUNAT: bloqueada hasta habilitarla tras la homologación.
BILLING_PRODUCTION_ENABLED=false
# Modo práctica (simulador con series TB01/TF01/TC01, marcadas como prueba).
# false = negocios sin facturación activa no pueden registrar ventas.
ALLOW_MOCK_BILLING=true

# Series reales (Nubefact: deben existir en la cuenta del negocio).
DEFAULT_BOLETA_SERIES=B001
DEFAULT_FACTURA_SERIES=F001
DEFAULT_NC_BOLETA_SERIES=BC01
DEFAULT_NC_FACTURA_SERIES=FC01
DEFAULT_ND_BOLETA_SERIES=BD01
DEFAULT_ND_FACTURA_SERIES=FD01
# Guías de remisión: remitente empieza con T, transportista con V.
DEFAULT_GUIA_REMITENTE_SERIES=T001
DEFAULT_GUIA_TRANSPORTISTA_SERIES=V001
# Plazo (días calendario desde la emisión) para la comunicación de baja.
VOIDING_MAX_DAYS=7

# Reintentos/conciliación de comprobantes pendientes en el servidor.
RECEIPT_WORKER_ENABLED=true
RECEIPT_WORKER_INTERVAL_MS=60000
RECEIPT_MAX_ATTEMPTS=12
RECEIPT_STALE_SENDING_SECONDS=120

# App web (PWA) servida por la API en el mismo dominio. Requiere HTTPS en producción.
WEB_DIST_DIR=
# true si la API corre detrás de un balanceador/proxy (IP real para límites de intentos).
TRUST_PROXY=false
AUTH_RATE_LIMIT_MAX=10
LOOKUP_RATE_LIMIT_MAX=60
PUBLIC_RATE_LIMIT_MAX=120

# Nubefact usa NUBEFACT_API_URL / NUBEFACT_API_TOKEN (arriba). El adaptador genérico `external`
# (EXTERNAL_API_TOKEN, EXTERNAL_ISSUE_PATH) usa BILLING_API_BASE_URL y las variables BILLING_*.

# Consulta automatizada de clientes DNI/RUC.
# Mantener el token SOLO en backend. Nunca usar EXPO_PUBLIC_ para este secreto.
# Valores: mock | apiperudev | external
DOCUMENT_LOOKUP_PROVIDER=mock
DOCUMENT_LOOKUP_API_BASE_URL=https://api.apiperu.dev
DOCUMENT_LOOKUP_API_TOKEN=
DOCUMENT_LOOKUP_TIMEOUT_MS=8000

# Costo unitario estimado del contrato con el proveedor de DNI.
# Ejemplo comercial: S/ 30 / 1000 consultas => 0.03.
# Se deja en 0 hasta definir el contrato real.
DOCUMENT_LOOKUP_DNI_COST_PEN=0

# Proveedores candidatos. Los tokens permanecen solo en backend/Secret Manager.
APISPERU_API_BASE_URL=https://facturacion.apisperu.com/api/v1/
APISPERU_API_TOKEN=
APISPERU_TIMEOUT_MS=15000
APISPERU_HEALTH_PATH=

EFACT_API_BASE_URL=
EFACT_API_TOKEN=
EFACT_HEALTH_PATH=

SENDA_API_BASE_URL=
SENDA_API_TOKEN=
SENDA_HEALTH_PATH=

# Enlaces públicos firmados para compartir comprobantes.
# En producción PUBLIC_APP_BASE_URL debe ser HTTPS y accesible desde Internet.
PUBLIC_APP_BASE_URL=http://localhost:4000
PUBLIC_RECEIPT_LINK_SECRET=replace-with-a-long-random-secret-for-public-links
# 30 días. Puede renovarse desde el historial.
PUBLIC_RECEIPT_LINK_TTL_SECONDS=2592000

# Entrega automática al cliente.
# disabled = no finge envíos; mock = solo pruebas internas.
# Producción requerirá adaptadores de WhatsApp Business / SMS / Email.
DELIVERY_PROVIDER=disabled

# Padrón Reducido RUC oficial de SUNAT. Se descarga e indexa en PostgreSQL.
# Fuente oficial: https://www.sunat.gob.pe/descargaPRR/mrc137_padron_reducido.html
SUNAT_RUC_PADRON_URL=https://www2.sunat.gob.pe/padron_reducido_ruc.zip
SUNAT_RUC_BATCH_SIZE=5000
# Protección contra archivos truncados/cambios de formato antes de depurar registros viejos.
SUNAT_RUC_MIN_ROWS=5000000
SUNAT_RUC_PRUNE_MISSING=true
# Solo aplica si se usa un proveedor externo como respaldo para RUC no hallado en el padrón.
DOCUMENT_LOOKUP_RUC_COST_PEN=0

# Sandbox real APIsPERU (solo para prueba controlada)
# El token debe corresponder a una empresa configurada en ambiente beta en APIsPERU.
APISPERU_SANDBOX_RUC=
APISPERU_SANDBOX_LEGAL_NAME=
APISPERU_SANDBOX_TRADE_NAME=
APISPERU_SANDBOX_ADDRESS=
APISPERU_SANDBOX_UBIGEO=
APISPERU_SANDBOX_DEPARTMENT=
APISPERU_SANDBOX_PROVINCE=
APISPERU_SANDBOX_DISTRICT=
APISPERU_SANDBOX_SERIES=B001
APISPERU_SANDBOX_CORRELATIVE=1
# Dejar vacio para probar solo conectividad. Colocar YES solo si se desea emitir en beta.
APISPERU_SANDBOX_CONFIRM=

# --- Seguridad, sesiones y operación (usadas por el código; valores de ejemplo) ---
# Clave maestra de la bóveda de credenciales (AES-256-GCM). Obligatoria en producción.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_MASTER_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# Orígenes permitidos por CORS en producción, separados por comas.
CORS_ORIGINS=
# Webhook (Slack/Discord) para alertas de documentos atascados o worker caído.
ALERT_WEBHOOK_URL=
# Puerto: en hosting (Railway, Render) lo asigna la plataforma como PORT y tiene prioridad sobre API_PORT.
# PORT=

# --- Demo pública (solo para demostraciones; NUNCA con datos reales) ---
DEMO_AUTOSEED=false
DEMO_PUBLIC_LOGIN=false
